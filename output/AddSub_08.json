      {
        "tag": "AUTO_SERVER",
        "selector": [
          "proxy"
        ],
        "strategy": {
          "type": "leastLoad",
          "settings": {
            "expected": 3,
            "baselines": [
              "120ms",
              "250ms",
              "500ms"
            ]
          }
        },
        "fallbackTag": "proxy"
      }
    ],
    "domainStrategy": "AsIs"
  },
